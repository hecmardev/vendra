# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plataforma
NEXT_PUBLIC_BASE_DOMAIN=vendra.com.mx

# Correos con acceso al panel de plataforma (/admin), separados por coma.
# Sin esto, /admin no deja entrar a nadie.
PLATFORM_ADMIN_EMAILS=

# Notificación de leads por email (Resend). Sin RESEND_API_KEY, se omite el envío
# (el lead igual se guarda). Para probar sin verificar dominio usa el from default.
RESEND_API_KEY=
# RESEND_FROM="Vendra <onboarding@resend.dev>"   # opcional; default ya usa onboarding@resend.dev

# Desarrollo (solo en dev):
#   localhost:3000        -> sitio de PLATAFORMA
#   demo.localhost:3000   -> storefront del dealer demo (DEV_DEALER_ID)
# DEV_DEALER_ID=00000000-0000-0000-0000-000000000001

# Semilla de QA (scripts/seed-qa.mjs). Las contraseñas NO van a git.
QA_ADMIN_EMAIL=admin@vendra.com.mx
QA_ADMIN_PASSWORD=
QA_DEALER_NAME=AutosDemo
QA_DEALER_DOMAIN=demo.test.vendra.com.mx
QA_DEALER_EMAIL=demo@vendra.com.mx
QA_DEALER_PASSWORD=
